# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN / BOT_TOKEN: Token received from @BotFather in Telegram.
# Example: 7123456789:AAFxxyyzz...
TELEGRAM_BOT_TOKEN=""
BOT_TOKEN=""

# TELEGRAM_BOT_USERNAME: Username of your telegram bot (without @).
# Example: kyrgyzakylman_bot
TELEGRAM_BOT_USERNAME="kyrgyzakylman_bot"
